# ── Harbor Glass app configuration ─────────────────────────────────────────
# Copy to .env.local and fill in what you have. Every integration is optional:
# the app runs fully in demo mode without any keys.

# OpenAI — powers AI-written outreach messages, marketing copy, and live chat.
# Without it, the app uses its built-in template engine.
OPENAI_API_KEY=

# Google Maps / Places — powers the live business Lead Finder search and the
# embedded route map. Without it, the app uses sample leads and a built-in map.
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Firebase (Auth + Firestore) — for real multi-device login and cloud data.
# Without it, the app uses local demo login and stores data in your browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Payments — paste your hosted payment links / handles (shown on invoices).
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
NEXT_PUBLIC_SQUARE_PAYMENT_LINK=
NEXT_PUBLIC_CASHAPP_CASHTAG=
NEXT_PUBLIC_VENMO_HANDLE=

# Google Reviews — your Google review short link (g.page/r/... link).
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
